{
  "name": "gantry-site",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "data": "bun run scripts/gen-data.ts",
    "og": "bun run data && bun run scripts/gen-og.ts",
    "dev": "bun run data && vite dev",
    "build": "bun run data && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.5"
  }
}
