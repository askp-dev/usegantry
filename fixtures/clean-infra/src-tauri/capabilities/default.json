{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-appdata-read-recursive",
    { "identifier": "fs:scope", "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**/*" }] },
    { "identifier": "http:default", "allow": [{ "url": "https://api.northwind.example" }] },
    { "identifier": "shell:allow-execute", "allow": [{ "name": "binaries/helper", "sidecar": true, "args": ["--sync"] }] }
  ]
}
