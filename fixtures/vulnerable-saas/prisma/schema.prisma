datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
generator client { provider = "prisma-client-js" }

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  credits   Int      @default(10)
  role      String   @default("user")
  posts     Post[]
  @@map("users")
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
}
