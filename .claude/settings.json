{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000"
  },
  "permissions": {
    "allow": [
      "Bash(bun install:*)",
      "Bash(bun test:*)",
      "Bash(bun run:*)",
      "Bash(bun -e:*)",
      "Bash(bun build:*)",
      "Bash(bunx biome:*)",
      "Bash(bunx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Read(./preflight-web/**)",
      "Edit(./preflight-web/**)",
      "Write(./preflight-web/**)",
      "Read(./data/subprocessor-map.json)",
      "Read(./data/known-packages.sqlite)",
      "Read(./data/seed/**)",
      "Read(./**/bun.lock)",
      "Read(./**/package-lock.json)",
      "Read(./**/dist/**)",
      "Read(./_to_delete/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "enableAllProjectMcpServers": true
}
