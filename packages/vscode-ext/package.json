{
  "name": "gantry-vscode",
  "displayName": "Gantry — Pre-Flight Security, Privacy & EULA",
  "description": "Launch-readiness diagnostics, CodeLens fixes and Mission Control for AI-generated repos.",
  "publisher": "usegantry",
  "private": true,
  "version": "0.1.2",
  "license": "MIT",
  "repository": "github:askp-dev/usegantry",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:package.json",
    "workspaceContains:pyproject.toml",
    "workspaceContains:requirements.txt"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Gantry runs a local scanner binary against the workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "gantry.scan",
        "title": "Gantry: Scan Workspace"
      },
      {
        "command": "gantry.fixWithAgent",
        "title": "Gantry: Fix with AI Agent"
      },
      {
        "command": "gantry.openMissionControl",
        "title": "Gantry: Open Mission Control"
      },
      {
        "command": "gantry.debugAgentCommands",
        "title": "Gantry (Developer): List Agent Chat Commands"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gantry",
          "title": "Gantry",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "gantry": [
        {
          "type": "webview",
          "id": "gantry.sidebar",
          "name": "Readiness"
        }
      ]
    },
    "configuration": {
      "title": "Gantry",
      "properties": {
        "gantry.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "gantry"
          ],
          "scope": "machine",
          "markdownDescription": "Command (argv) that runs the Gantry CLI, e.g. `[\"bun\", \"/path/to/cli.ts\"]`. Machine-scoped so a workspace can't swap in another binary."
        },
        "gantry.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-scan (debounced) after saving a file."
        },
        "gantry.agentCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "composer.startComposerPrompt",
            "aichat.newchataction",
            "windsurf.sendTextToChat",
            "antigravity.sendPromptToAgentPanel",
            "claude-vscode.editor.open",
            "chatgpt.openSidebar",
            "workbench.action.chat.open"
          ],
          "scope": "machine",
          "description": "Command IDs tried in order after the fix prompt is copied: Cursor, Windsurf/Devin Cascade, Antigravity, Claude Code, Codex, then VS Code's built-in chat. The first one the IDE has is run. Run \"Gantry (Developer): List Agent Chat Commands\" to see your IDE's IDs."
        }
      }
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "bun run build && bunx @vscode/vsce@3.9.2 package --no-dependencies",
    "test:edh": "bun run build && bun run test/run-edh.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.5.2"
  }
}
