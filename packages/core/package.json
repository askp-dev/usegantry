{
  "name": "@preflight/core",
  "version": "0.1.0",
  "type": "module",
  "bin": { "preflight": "./src/bin/cli.ts" },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/context/types.ts"
  },
  "scripts": {
