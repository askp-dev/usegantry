{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "files": { "includes": ["packages/**", "scripts/**", "!**/node_modules", "!**/dist", "!fixtures/**"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "linter": { "enabled": true, "rules": { "recommended": true, "suspicious": { "noExplicitAny": "off" }, "style": { "noNonNullAssertion": "off" } } },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } }
}
